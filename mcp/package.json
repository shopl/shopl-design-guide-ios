{
  "name": "sdg-ios-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "SDG iOS(ShoplDesignGuide) 디자인 시스템의 토큰·컴포넌트 API·아이콘·사용 예제를 AI 코딩 에이전트에 제공하는 MCP 서버",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "generate:metadata": "swift run --package-path ../Tools/SDGMetadataExtractor sdg-metadata --repo-root .. --output ../plugins/sdg-ios/server/data",
    "bundle": "node scripts/bundle.mjs",
    "build": "npm run generate:metadata && npm run bundle",
    "start": "node ../plugins/sdg-ios/server/index.mjs",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "esbuild": "0.25.12",
    "typescript": "6.0.3"
  }
}
